<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- The three entries electron-builder applies by default under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The practice call window can show the candidate's own camera preview. Without this
         entitlement the hardened runtime refuses camera access whatever the user allows. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- Practice calls hear the candidate through the bundled audio helper. macOS charges the helper's
         microphone request to this app, so without this entitlement the hardened runtime refuses the
         microphone silently: no prompt, and the helper runs on silence (found 2026-11-21: no call had
         ever heard the microphone). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
