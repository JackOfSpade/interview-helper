{
  "name": "interview-helper",
  "private": true,
  "version": "0.0.0",
  "author": "Antigravity",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "type": "module",
  "main": "dist-electron-interview/main.cjs",
  "scripts": {
    "dev": "vite --config vite.interview.config.js",
    "build:compile": "vite build --config vite.interview.config.js",
    "build": "node scripts/build-macos.mjs",
    "lint": "eslint .",
    "test:unit": "node --import ./scripts/test-stubs/register.mjs scripts/run-tests.mjs",
    "test:scripts": "node --import ./scripts/test-stubs/register.mjs --test scripts/*.test.mjs scripts/practice-probes/*.test.mjs",
    "test": "npm run test:unit && npm run test:scripts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.305",
    "deepmerge": "file:vendor/deepmerge-4.3.2-ic.1.tgz",
    "html-to-text": "^10.0.1",
    "jsdom": "^29.0.2",
    "onnxruntime-node": "^1.31.1",
    "opusscript": "^0.1.1",
    "parse5": "^8.0.0",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.10.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.4.0",
    "lucide-react": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "8.3.4",
    "vite-plugin-electron": "^0.29.1",
    "playwright": "1.59.1"
  },
  "overrides": {
    "global-agent": "4.1.3",
    "deepmerge": "$deepmerge",
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  }
}
